# Copy this file to .env and fill in real values. Never commit .env itself.

DEBUG=True
SECRET_KEY=nuttertools

# PostgreSQL (Supabase)
# For pooler connections, user is usually `postgres.<project-ref>`.
DB_NAME=postgres
DB_USER=postgres.your_project_ref
DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD
DB_HOST=aws-0-your-region.pooler.supabase.com
DB_PORT=5432
DB_SCHEMA=public
DB_SSLMODE=require

# Comma-separated origins allowed to call the API (no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Email (Mailtrap SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@talentsync.local
